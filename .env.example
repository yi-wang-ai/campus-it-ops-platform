# Generate unique 32+ character secrets with: python -c 'import secrets; print(secrets.token_urlsafe(36))'
# Copy to .env and replace ALL placeholders before starting.
ZABBIX_WEBHOOK_TOKEN=replace-with-unique-random-secret-0001
VIEWER_API_TOKEN=replace-with-unique-random-secret-0002
ADMIN_API_TOKEN=replace-with-unique-random-secret-0003
DASHBOARD_USERNAME=labadmin
DASHBOARD_PASSWORD=replace-with-unique-random-secret-0004
DATABASE_PATH=./data/incidents.sqlite
# Only approved lab inventory labels; never use internet-facing hosts.
LAB_ALLOWED_HOSTS=lab-vm-01
OPS_API_URL=http://127.0.0.1:8000
