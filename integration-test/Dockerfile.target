FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx openssh-server curl sudo python3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# SSH setup — key-based auth for Ansible
RUN mkdir -p /run/sshd && \
    sed -i 's/#PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    useradd -m -s /bin/bash labops && \
    echo "labops ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/labops && \
    mkdir -p /home/labops/.ssh && chown labops:labops /home/labops/.ssh && chmod 700 /home/labops/.ssh

# Generate a lab-only SSH key pair at build time (test only; not a secret)
RUN ssh-keygen -t ed25519 -f /home/labops/.ssh/lab_key -N "" -C "lab-integration-test" && \
    cp /home/labops/.ssh/lab_key.pub /home/labops/.ssh/authorized_keys && \
    chown -R labops:labops /home/labops/.ssh && chmod 600 /home/labops/.ssh/authorized_keys

# nginx default page
RUN echo '<html><body><h1>Lab Target OK</h1></body></html>' > /var/www/html/index.html

COPY entrypoint-target.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 80

CMD ["/entrypoint.sh"]
